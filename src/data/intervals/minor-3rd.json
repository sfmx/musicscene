  "theoreticalContext": {
    "harmonicFunction": [
      {
        "title": "Emotional Associations",
        "description": "The minor 3rd creates feelings of introspection, melancholy, and emotional depth. It's neither harsh nor overly sweet, making it perfect for expressing complex emotions."
      },
      {
        "title": "Cultural Context",
        "description": "In Western music, minor 3rds are associated with sadness, contemplation, and sophistication, though this varies across different musical cultures."
      }
    ],
    "historicalDevelopment": [
      {
        "title": "Dramatic Effect",
        "description": "Composers use minor 3rds to create emotional contrast, build tension, and provide resolution through major-minor relationships."
      },
      {
        "title": "Genre Characteristics",
        "description": "Essential in blues, jazz, classical minor keys, and modern alternative/indie music for creating authentic emotional expression."
      }
    ]
  },

  "theoreticalContext": {
    "harmonicFunction": [
      {
        "title": "Chord Quality Determinant",
        "description": "The major 3rd is what makes a chord \"major\" - it's the defining interval that creates the bright, stable character we associate with major harmony."
      },
      {
        "title": "Tonal Center Establishment",
        "description": "Major 3rds help establish and confirm key centers, especially in cadential progressions and tonic chord resolutions."
      }
    ],
    "historicalDevelopment": [
      {
        "title": "Just Intonation",
        "description": "In pure tuning, the major 3rd has a frequency ratio of 5:4, which creates the sweetest possible consonance for this interval."
      },
      {
        "title": "Equal Temperament",
        "description": "Modern tuning slightly compresses the major 3rd, but it remains one of the most consonant and stable intervals in music."
      }
    ]
  },

  "theoreticalContext": {
    "harmonicFunction": [
      {
        "title": "4:3 Ratio",
        "description": "The perfect 4th has a 4:3 frequency ratio, creating a stable but slightly hollow sound due to the wider ratio."
      },
      {
        "title": "Complementary to 5th",
        "description": "Perfect 4th + Perfect 5th = Octave (5 + 7 = 12 semitones)"
      }
    ],
    "historicalDevelopment": [
      {
        "title": "Medieval Organum",
        "description": "Perfect 4ths were considered the most consonant interval in medieval music, used extensively in early polyphony."
      },
      {
        "title": "Modern Recontextualization",
        "description": "Jazz and modern music have rediscovered the 4th's unique harmonic color through quartal harmony."
      }
    ]

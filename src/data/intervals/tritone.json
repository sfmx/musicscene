  "theoreticalContext": {
    "harmonicFunction": [
      {
        "title": "\"Diabolus in Musica\"",
        "description": "Medieval church considered the tritone so dissonant and unstable that it was forbidden in sacred music, earning the nickname \"the devil in music.\""
      },
      {
        "title": "Theoretical Foundation",
        "description": "The tritone perfectly divides the octave in half, creating maximum distance from consonant perfect intervals."
      }
    ],
    "historicalDevelopment": [
      {
        "title": "Tonal Harmony Driver",
        "description": "In tonal music, the tritone creates the tension that drives harmonic progression, especially in dominant 7th chords resolving to tonic."
      },
      {
        "title": "Jazz and Blues Essential",
        "description": "Modern jazz and blues rely heavily on tritone harmony for their characteristic sound and harmonic sophistication."
      }
    ]
  },

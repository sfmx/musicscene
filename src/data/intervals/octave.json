  "theoreticalContext": {
    "harmonicFunction": [
      {
        "title": "2:1 Ratio",
        "description": "The octave has the simplest frequency relationship possible - exactly double or half the frequency, creating perfect acoustic unity."
      },
      {
        "title": "Harmonic Series",
        "description": "The octave appears as the 2nd harmonic in the natural harmonic series, making it the first and strongest overtone."
      }
    ],
    "historicalDevelopment": [
      {
        "title": "Universal Recognition",
        "description": "Every musical culture recognizes octave equivalence - notes an octave apart are considered the \"same\" note."
      },
      {
        "title": "Perceptual Unity",
        "description": "The brain processes octaves as so similar that they create a sense of completion and return."
      }
    ]

  "introduction": {
    "title": "How Microphones Work",
    "text": "Microphones are transducers that convert acoustic energy (sound waves) into electrical energy (audio signals). Different microphone types use various methods to achieve this conversion, each with unique characteristics.",
    "columns": [
      {
        "title": "Transduction Methods",
        "text": "Dynamic: Moving coil generates signal. Condenser: Capacitor plates change distance. Ribbon: Metal ribbon moves in magnetic field. Carbon: Pressure changes resistance (vintage). Piezo: Crystal generates voltage."
      },
      {
        "title": "Key Specifications",
        "text": "Frequency Response: Range and coloration. Sensitivity: Output level for given input. SPL Handling: Maximum sound pressure. Self-Noise: Inherent electronic noise. Polar Pattern: Directional pickup."
      }
    ]
  },

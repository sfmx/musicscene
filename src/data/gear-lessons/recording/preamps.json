    {
      "title": "Preamp Setup & Usage",
      "layout": "list",
      "cards": [
        {
          "title": "Proper Gain Staging",
          "description": "Set preamp gain for optimal signal level without clipping. Aim for -18 to -12 dBFS peaks for most digital systems, leaving headroom for dynamics and processing."
        },
        {
          "title": "Impedance Matching",
          "description": "Most microphones work best with preamp input impedances 5-10 times higher than the mic's output impedance. Some preamps offer selectable impedance for different colors."
        },
        {
          "title": "Signal Chain Position",
          "description": "External preamps go between microphone and audio interface line input. Bypass interface preamps when using external units to avoid double-amplification."
        },
        {
          "title": "Warming Up Tube Preamps",
          "description": "Tube preamps need 15-30 minutes to reach optimal operating temperature. The sound will stabilize and reach full warmth after proper warm-up time."
        }
      ]
    }

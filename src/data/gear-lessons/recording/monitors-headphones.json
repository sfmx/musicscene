    {
      "title": "Professional Listening Tips",
      "layout": "list",
      "cards": [
        {
          "title": "Use Reference Tracks",
          "description": "Always have commercial releases in your genre that you know well. These help you understand how your monitors translate and what good mixes sound like."
        },
        {
          "title": "Monitor at Reasonable Levels",
          "description": "Loud monitoring can damage hearing and lead to poor mix decisions. Mix at 85dB SPL or lower, and take regular breaks."
        },
        {
          "title": "Cross-Reference Your Mixes",
          "description": "Check your mixes on multiple systems: car stereo, earbuds, phone speakers, and other playback devices to ensure good translation."
        },
        {
          "title": "Trust Your Monitors",
          "description": "Once you know your monitors well, trust what they tell you. Avoid constant tweaking based on other playback systems."
        }
      ]

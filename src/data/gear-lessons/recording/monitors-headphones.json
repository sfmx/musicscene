  "introduction": {
    "title": "Why Accurate Monitoring Matters",
    "text": "Your monitoring system is your reference for all creative and technical decisions. Inaccurate monitors can lead to mixes that sound great in your studio but terrible everywhere else. Good monitors reveal the truth about your recordings.",
    "columns": [
      {
        "title": "What Accurate Monitors Provide",
        "text": "Flat, uncolored frequency response. Clear stereo imaging and soundstage. Detailed resolution of mix elements. Consistent performance at various levels. Truthful representation of your recordings. Predictable translation to other systems."
      },
      {
        "title": "Problems with Poor Monitoring",
        "text": "Mixes that don't translate well. Over or under-compensation for frequency peaks. Inability to hear subtle details. Poor stereo imaging decisions. Inconsistent mix levels. Fatigue from listening on harsh systems."
      }
    ]
  },

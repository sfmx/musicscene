      "cards": [
        {
          "title": "Interval Inversion",
          "description": "When you invert an interval (flip it upside down), you get its complement. This creates related but different emotional colors.",
          "borderColor": "border-purple-200",
          "bgColor": "bg-white",
          "fields": [
            { "label": "Examples", "value": "Major 3rd -> Minor 6th, Perfect 4th -> Perfect 5th, Minor 2nd -> Major 7th" }
          ]
        },
        {
          "title": "Compound Intervals",
          "description": "Intervals larger than an octave (9ths, 11ths, 13ths) have similar character to their simple forms but with added sophistication.",
          "borderColor": "border-purple-200",
          "bgColor": "bg-white",
          "fields": [
            { "label": "Examples", "value": "Major 9th = Major 2nd + Octave, Perfect 11th = Perfect 4th + Octave, Major 13th = Major 6th + Octave" }
          ]
        }
      ]
    },
